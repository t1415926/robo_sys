<?xml version="1.0"?>
<robot name="simple_omni_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <material name="body_blue">
    <color rgba="0.1 0.35 0.8 1.0"/>
  </material>
  <material name="front_green">
    <color rgba="0.1 0.8 0.25 1.0"/>
  </material>

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.42 0.32 0.16"/>
      </geometry>
      <material name="body_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.42 0.32 0.16"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.05" ixy="0.0" ixz="0.0" iyy="0.08" iyz="0.0" izz="0.09"/>
    </inertial>
  </link>

  <link name="front_marker_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.22 0.04"/>
      </geometry>
      <material name="front_green"/>
    </visual>
  </link>

  <joint name="front_marker_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_marker_link"/>
    <origin xyz="0.18 0 0.1" rpy="0 0 0"/>
  </joint>
</robot>
